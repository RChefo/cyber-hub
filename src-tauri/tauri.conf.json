{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cyber Hub",
  "version": "0.1.0",
  "identifier": "dev.cyberhub.workstation",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build && node scripts/build-sidecar.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "ExploitX",
        "width": 1440,
        "height": 900,
        "minWidth": 800,
        "minHeight": 480,
        "center": true,
        "visible": false,
        "decorations": false,
        "shadow": false,
        "backgroundColor": "#0A0B10",
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'none'",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Cybersecurity intelligence and security research platform",
    "longDescription": "ExploitX is a local-first cybersecurity workspace for security research, assessment, investigation and workflow management: projects and findings, OSINT investigations, threat and vulnerability intelligence, detection engineering, reports and MCP integration.",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "desktopTemplate": "linux/exploitx.desktop.hbs"
      },
      "rpm": {
        "desktopTemplate": "linux/exploitx.desktop.hbs"
      }
    },
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installerHooks": "windows/installer-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk1N0YzRjdEOTU1QzcyRkEKUldUNmNseVZmVDkvbFFNdmtKdFEzY2lYZ2xpaXlxSWU1ZDYxa2swc2diTVNQUWhIT1ZLSkhqTjkK",
      "endpoints": [],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
