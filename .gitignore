# dependencies and build output
node_modules
dist
src-tauri/target
src-tauri/gen/schemas
# staged MCP sidecar (scripts/build-sidecar.mjs), built for each release
src-tauri/binaries/
*.tsbuildinfo
coverage
.vite

# local data: Cyber Hub stores user data in the OS app-data directory, never in the repo;
# these patterns keep accidental copies out of version control
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# secrets and environment (provider credentials are provisioned with `cyberhub-keys`;
# local secrets files must never be committed — see docs/PROVISIONING.md)
secrets.local.*
*.secrets
*.secrets.env
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx

# logs and OS / editor files
*.log
.DS_Store
Thumbs.db
.idea
.vscode/*
!.vscode/extensions.json

# local design reference (third-party screenshot, not part of the product)
docs/reference/

# QA probe output (screenshots, results)
scripts/qa/out/
